# zlib dictionary for fuzzing
# zlib header magic bytes (CMF, FLG)
"\x78\x01"
"\x78\x5e"
"\x78\x9c"
"\x78\xda"

# gzip header magic
"\x1f\x8b"
"\x1f\x8b\x08"

# gzip flags
"\x1f\x8b\x08\x00"
"\x1f\x8b\x08\x08"
"\x1f\x8b\x08\x10"

# Deflate block types (BFINAL=0/1, BTYPE=00/01/10/11)
"\x00"
"\x01"
"\x02"
"\x03"
"\x04"
"\x05"
"\x06"

# Common deflate fixed Huffman codes
"\x63\x00\x00"
"\x03\x00"
"\x4b"
"\xcb"

# Adler-32 checksum patterns
"\x00\x00\x00\x01"
"\x00\x01\x00\x01"

# Window size indicators
"\x08"
"\x0f"
"\x78"

# Compression method (deflate = 8)
"\x08"

# Compression levels in zlib header
"\x01"
"\x5e"
"\x9c"
"\xda"

# End-of-block markers
"\x00\x00\xff\xff"
"\x03\x00"

# Length/distance code patterns
"\x00\x00\x00\x00"
"\xff\xff"
"\xff\xff\xff\xff"

# Useful string patterns for testing
"IDAT"
"IEND"
"IHDR"

# Common sizes
"\x00\x01"
"\x01\x00"
"\xff\x00"
"\x00\xff"
"\xff\xff"
