# JSON dictionary for fuzzing
# Basic structural tokens
"{"
"}"
"["
"]"
":"
","

# Value literals
"true"
"false"
"null"

# String delimiters and escapes
"\""
"\\\""
"\\\\"
"\\/"
"\\b"
"\\f"
"\\n"
"\\r"
"\\t"
"\\u0000"
"\\u001f"
"\\uFFFF"
"\\uD800"
"\\uDBFF"
"\\uDC00"
"\\uDFFF"

# Number patterns
"0"
"-0"
"1"
"-1"
"0.0"
"1e1"
"1E1"
"1e+1"
"1e-1"
"1.0e1"
"-1.0e-1"
"9999999999999999"
"1.7976931348623157e+308"
"5e-324"

# Common key patterns
"\"key\""
"\"name\""
"\"value\""
"\"type\""
"\"id\""
"\"data\""
"\"items\""
"\"count\""

# Whitespace variants
" "
"\x09"
"\x0a"
"\x0d"
"\x0d\x0a"

# Edge cases
"{}"
"[]"
"\"\""
"[null]"
"{\"\":0}"
